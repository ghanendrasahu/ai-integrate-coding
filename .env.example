# Copy to .env and fill in your values.
# See README.md -> Configuration for details.

# LLM provider
AGENT_API_KEY=
AGENT_API_BASE=
AGENT_MODEL=gpt-4o
AGENT_PROVIDER=

# Local Ollama (only used when AGENT_PROVIDER=ollama or no key is set)
OLLAMA_BASE=http://localhost:11434/v1

# Embedding model used for RAG (only when an API key or Ollama is configured)
AGENT_EMBED_MODEL=text-embedding-3-small

# Sandbox image for isolated command execution (when --sandbox and Docker are available)
AGENT_SANDBOX_IMAGE=python:3.11-slim
