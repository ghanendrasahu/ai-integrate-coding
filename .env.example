# Copy to `.env` and fill in your values. Never commit the real `.env` (it is gitignored).

# ---- LLM provider ----
# OpenAI-compatible endpoint (Groq / OpenAI / Gemini-OpenAI / any).
AGENT_API_KEY=your-api-key-here
# AGENT_API_BASE=https://api.groq.com/openai/v1
# AGENT_MODEL=llama-3.3-70b-versatile

# Force a provider (optional; otherwise inferred from the key/env above).
# AGENT_PROVIDER=openai-compatible
# AGENT_PROVIDER=ollama   # uses a local Ollama server instead

# Embeddings for RAG notes (defaults: OpenAI text-embedding-3-small / Ollama nomic-embed-text).
# AGENT_EMBED_MODEL=text-embedding-3-small

# Docker image used for --sandbox command isolation.
# AGENT_SANDBOX_IMAGE=python:3.11-slim

# ---- Web frontend (optional) ----
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000
# FLASK_DEBUG=0
